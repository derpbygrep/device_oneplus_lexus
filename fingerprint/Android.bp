cc_defaults {
    name: "libshims_aidl_fingerprint.lexus_defaults",
    srcs: ["SensorPropsShim.cpp"],
    shared_libs: ["libbase"],
    device_specific: true,
}

cc_library_shared {
    name: "libshims_aidl_fingerprint_v2.lexus",
    defaults: ["libshims_aidl_fingerprint.lexus_defaults"],
    static_libs: ["android.hardware.biometrics.fingerprint-V2-ndk"],
}

cc_library_shared {
    name: "libshims_aidl_fingerprint_v3.lexus",
    defaults: ["libshims_aidl_fingerprint.lexus_defaults"],
    static_libs: ["android.hardware.biometrics.fingerprint-V3-ndk"],
}

cc_library_shared {
    name: "libshims_aidl_fingerprint_v4.lexus",
    defaults: ["libshims_aidl_fingerprint.lexus_defaults"],
    static_libs: ["android.hardware.biometrics.fingerprint-V4-ndk"],
}

